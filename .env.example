# Copy to .env (git-ignored) and fill in:  cp .env.example .env

DB_USER=shodruz
# Use URL-safe characters only (letters/digits): this value is embedded in the migration DSN.
# Generate one with:  openssl rand -hex 16
DB_PASSWORD=change-me
DB_NAME=myshop

# Signs access tokens. Generate one with:  openssl rand -hex 32
JWT_SECRET=change-me-too

# Origin of the frontend that is allowed to call the API (Vite dev server by default)
# CORS_ORIGIN=http://localhost:5173

# Optional port overrides
# API_PORT=8080
# DB_HOST_PORT=5433