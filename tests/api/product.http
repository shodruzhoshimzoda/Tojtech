### =========================================================
# GetProduct - GET /products/{uuid}
### =========================================================

### 11. Получить товар по UUID - happy path
GET {{baseUrl}}/products/{{productUuid}}

> {%
client.test("status 200", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
});
client.test("correct product returned", function () {
    client.assert(response.body.product.uuid === client.global.get("productUuid"), "uuid mismatch");
});
%}


### 12. Получить товар - невалидный формат UUID
GET {{baseUrl}}/products/not-a-valid-uuid

> {%
client.test("status 400", function () {
    client.assert(response.status === 400, "expected 400, got " + response.status);
});
%}


### 13. Получить товар - валидный UUID, которого нет
GET {{baseUrl}}/products/00000000-0000-0000-0000-000000000000

> {%
client.test("status 404", function () {
    client.assert(response.status === 404, "expected 404, got " + response.status);
});
%}


### =========================================================
# UpdateProduct - PATCH /products/{uuid}
### =========================================================

### 14. Обновить товар - happy path
PATCH {{baseUrl}}/products/{{productUuid}}
Content-Type: application/json

{
  "name": "iPhone 15 Pro",
  "slug": "iphone-15-test",
  "description": "256GB, Black",
  "price": 1199.99,
  "stock": 5,
  "category": { "uuid": "{{categoryUuid}}" }
}

> {%
client.test("status 200", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
});
client.test("fields updated", function () {
    client.assert(response.body.product.name === "iPhone 15 Pro", "name not updated");
    client.assert(response.body.product.stock === 5, "stock not updated");
});
%}


