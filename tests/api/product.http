### tests/product.http
### GoLand HTTP Client API Test для /api/v1/products
### Запускать сверху вниз (Run All Requests in File) — тесты используют
### client.global, чтобы передавать uuid категории/товара между запросами.
### Требования: сервер поднят на localhost:8080, БД смигрирована и доступна.

@baseUrl = http://localhost:8080/api/v1

# =========================================================
# 0. Подготовка: категория, к которой будем привязывать товары
# =========================================================

### 0. Создать категорию-фикстуру для тестов продуктов
POST {{baseUrl}}/categories
Content-Type: application/json

{
  "name": "Smartphones",
  "slug": "smartphones-test",
  "description": "fixture category for product tests"
}

> {%
client.test("category created", function () {
    client.assert(response.status === 201, "expected 201, got " + response.status);
    client.assert(response.body.category.uuid, "category uuid missing in response");
});
client.global.set("categoryUuid", response.body.category.uuid);
%}


### =========================================================
# GetProducts - GET /products
### =========================================================

### 1. Список всех товаров - happy path
GET {{baseUrl}}/products

> {%
client.test("status 200", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
});
client.test("has products array", function () {
    client.assert(Array.isArray(response.body.products), "products is not an array");
});
%}


### =========================================================
# CreateProduct - POST /products
### =========================================================

### 2. Создать товар - happy path
POST {{baseUrl}}/products
Content-Type: application/json

{
  "name": "iPhone 15",
  "slug": "iphone-15-test",
  "description": "128GB, Blue",
  "price": 999.99,
  "stock": 10,
  "category": {
    "uuid": "{{categoryUuid}}"
  }
}

> {%
client.test("status 201", function () {
    client.assert(response.status === 201, "expected 201, got " + response.status);
});
client.test("product body is correct", function () {
    client.assert(response.body.product.uuid, "product uuid missing");
    client.assert(response.body.product.slug === "iphone-15-test", "unexpected slug");
    client.assert(response.body.product.category.uuid === client.global.get("categoryUuid"), "category not linked");
});
client.global.set("productUuid", response.body.product.uuid);
%}


### 3. Создать товар - без поля category (ожидаем 400 "specified category does not exist")
POST {{baseUrl}}/products
Content-Type: application/json

{
  "name": "No Category Product",
  "slug": "no-category-test",
  "price": 10,
  "stock": 1
}

> {%
client.test("status 400", function () {
    client.assert(response.status === 400, "expected 400, got " + response.status);
});
%}
### NOTE: сейчас проходит валидацию Validate() (там Category не проверяется)
### и падает только в репозитории. Стоит явно проверять Category в Product.Validate().


### 4. Создать товар - несуществующая категория
POST {{baseUrl}}/products
Content-Type: application/json

{
  "name": "Ghost Category Product",
  "slug": "ghost-category-product-test",
  "price": 5,
  "stock": 1,
  "category": { "uuid": "00000000-0000-0000-0000-000000000000" }
}

> {%
client.test("status 400", function () {
    client.assert(response.status === 400, "expected 400, got " + response.status);
});
client.test("error message", function () {
    client.assert(response.body.error === "specified category does not exist", "unexpected error: " + response.body.error);
});
%}


