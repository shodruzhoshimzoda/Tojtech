### =========================================================
# Product images - POST/DELETE /products/{uuid}/images
### =========================================================

### 19. Добавить картинку товару - happy path
POST {{baseUrl}}/products/{{productUuid}}/images
Content-Type: application/json

{
  "image_url": "https://cdn.example.com/iphone-15-front.jpg",
  "is_main": true
}

> {%
client.test("status 201", function () {
    client.assert(response.status === 201, "expected 201, got " + response.status);
});
client.global.set("imageUuid", response.body.image.uuid);
%}


### 20. Добавить картинку - невалидный URL
POST {{baseUrl}}/products/{{productUuid}}/images
Content-Type: application/json

{ "image_url": "not-a-url", "is_main": false }

> {%
client.test("status 400", function () {
    client.assert(response.status === 400, "expected 400, got " + response.status);
});
%}


### 21. Удалить картинку - happy path
DELETE {{baseUrl}}/products/{{productUuid}}/images/{{imageUuid}}

> {%
client.test("status 204", function () {
    client.assert(response.status === 204, "expected 204, got " + response.status);
});
%}


