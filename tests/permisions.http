POST {{baseUrl}}/categories
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJleHAiOjE3OTAxMzU3MzMsImlhdCI6MTc5MDA0OTMzMywicm9sZSI6ImN1c3RvbWVyIiwic3ViIjoiMmNmYTQ0OGUtOGI4ZC00NmQ1LTk1Y2QtNmRlNzZlY2ZlZDcyIn0.MWy7-trBXJF0iHfEKvGBAiP8t42zUa5_8-AMfUvJXXY
